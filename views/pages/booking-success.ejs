<%- include('../partials/header') %>

<main class="container" style="display: flex; justify-content: center; align-items: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 600px; padding: 3rem; text-align: center;">
    <div style="font-size: 4rem; color: #10b981; margin-bottom: 1rem;">
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <h2 style="margin-bottom: 1rem;">Booking Berhasil!</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">Terima kasih <strong><%= booking.customerName %></strong>, pesanan Anda telah kami terima.</p>
    
    <div style="background: #f8fafc; padding: 1.5rem; border-radius: 8px; border: 1px dashed var(--border); margin-bottom: 2rem; text-align: left;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
        <span style="color: var(--text-muted);">ID Booking:</span>
        <span style="font-weight: 700;">#BKG-<%= booking.id %></span>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
        <span style="color: var(--text-muted);">Trip:</span>
        <span style="font-weight: 600;"><%= booking.trip.title %></span>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
        <span style="color: var(--text-muted);">Tanggal:</span>
        <span><%= new Date(booking.bookingDate).toLocaleDateString('id-ID') %></span>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
        <span style="color: var(--text-muted);">Peserta:</span>
        <span><%= booking.totalTickets %> Pax</span>
      </div>
      <hr style="margin: 1rem 0; border-top: 1px dashed var(--border);">
      <div style="display: flex; justify-content: space-between; font-size: 1.25rem;">
        <span style="font-weight: 500;">Total Tagihan:</span>
        <span style="font-weight: 800; color: var(--primary);">Rp <%= booking.totalPrice.toLocaleString('id-ID') %></span>
      </div>
    </div>

    <div style="background: #fffbeb; color: #b45309; padding: 1rem; border-radius: 8px; margin-bottom: 2rem; font-size: 0.9rem;">
      <i class="fa-solid fa-circle-info" style="margin-right: 0.5rem;"></i>
      Silakan transfer ke <strong>[ISI_NO_REK_DAN_BANK_LO_DI_SINI]</strong>, lalu konfirmasi via WhatsApp.
    </div>

    <a href="https://wa.me/[NOMOR_WA_LO]?text=Halo%20Admin,%20saya%20mau%20konfirmasi%20pembayaran%20booking%20ID:%20%23BKG-<%= booking.id %>" target="_blank" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
      <i class="fa-brands fa-whatsapp text-lg"></i> Konfirmasi Pembayaran
    </a>
    <div style="margin-top: 1rem;">
      <a href="/" class="btn btn-outline">Kembali ke Beranda</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
