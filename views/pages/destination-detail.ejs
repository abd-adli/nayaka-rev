<%- include('../partials/header') %>

<main class="container" style="margin-top: 2rem;">
  <div class="detail-header">
    <img src="<%= destination.thumbnail %>" alt="<%= destination.title %>" onerror="this.src='https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=1200&q=80'">
    <div class="detail-overlay">
      <h1><%= destination.title %></h1>
    </div>
  </div>

  <div style="font-size: 1.1rem; line-height: 1.8; color: var(--text-main); margin-bottom: 3rem;">
    <%- destination.content %>
  </div>

  <hr style="border: 0; border-top: 1px solid var(--border); margin: 3rem 0;">

  <h2>Available Trips & Packages</h2>
  <div class="trip-list">
    <% if (destination.trips && destination.trips.length > 0) { %>
      <% destination.trips.forEach(trip => { %>
        <div class="trip-item">
          <div class="trip-item-info">
            <h4><%= trip.title %></h4>
            <p style="color: var(--text-muted); margin-bottom: 0.5rem;"><%= trip.description %></p>
            <span style="font-size: 0.9rem; background: #e2e8f0; padding: 0.2rem 0.5rem; border-radius: 4px;">Capacity: <%= trip.capacity %> pax</span>
          </div>
          <div style="text-align: right;">
            <div class="trip-price">Rp <%= trip.price.toLocaleString('id-ID') %></div>
            <button class="btn btn-primary" style="margin-top: 0.5rem;" onclick="openBookingModal('<%= trip.id %>', '<%= trip.title %>', <%= trip.price %>)">Book Now</button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p style="color: var(--text-muted);">No trips currently available for this destination.</p>
    <% } %>
  </div>
</main>

<!-- Booking Modal -->
<div id="bookingModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
  <div class="card" style="width: 100%; max-width: 500px; padding: 2rem; background: white; border-radius: 8px; position: relative;">
    <button onclick="closeBookingModal()" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
    <h3 style="margin-bottom: 1.5rem;">Form Pemesanan</h3>
    <h4 id="modalTripTitle" style="color: var(--primary); margin-bottom: 1.5rem;"></h4>
    
    <form action="/bookings" method="POST" id="bookingForm">
      <input type="hidden" name="tripId" id="modalTripId">
      
      <div class="form-group">
        <label class="form-label">Nama Lengkap</label>
        <input type="text" name="customerName" class="form-control" required>
      </div>
      
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="customerEmail" class="form-control" required value="<%= user ? user.email : '' %>">
      </div>

      <div class="form-group">
        <label class="form-label">Nomor WhatsApp / HP</label>
        <input type="tel" name="phone" class="form-control" required>
      </div>

      <div class="form-group">
        <label class="form-label">Tanggal Trip</label>
        <input type="date" name="bookingDate" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
      </div>

      <div class="form-group">
        <label class="form-label">Jumlah Peserta (Pax)</label>
        <input type="number" name="quantity" id="modalQuantity" class="form-control" required min="1" value="1" onchange="calculateTotal()">
      </div>

      <div style="background: #f1f5f9; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 500;">Total Harga:</span>
        <span id="modalTotalPrice" style="font-size: 1.25rem; font-weight: 700; color: var(--primary);">Rp 0</span>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">Konfirmasi Booking</button>
    </form>
  </div>
</div>

<script>
  let currentTripPrice = 0;

  function openBookingModal(tripId, tripTitle, price) {
    document.getElementById('bookingModal').style.display = 'flex';
    document.getElementById('modalTripId').value = tripId;
    document.getElementById('modalTripTitle').innerText = tripTitle;
    document.getElementById('modalQuantity').value = 1;
    currentTripPrice = price;
    calculateTotal();
  }

  function closeBookingModal() {
    document.getElementById('bookingModal').style.display = 'none';
  }

  function calculateTotal() {
    const qty = parseInt(document.getElementById('modalQuantity').value) || 1;
    const total = qty * currentTripPrice;
    document.getElementById('modalTotalPrice').innerText = 'Rp ' + total.toLocaleString('id-ID');
  }

  // Close modal when clicking outside
  document.getElementById('bookingModal').addEventListener('click', function(e) {
    if (e.target === this) closeBookingModal();
  });
</script>

<%- include('../partials/footer') %>
