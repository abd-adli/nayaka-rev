<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Nayaka Tour - Ke Majalengka Aja!' %></title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts: Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/images/logo.png">
  
  <!-- Tailwind Config -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Outfit', 'sans-serif'],
          },
          colors: {
            navy: {
              800: '#1e293b',
              900: '#0f172a',
              950: '#020617',
            },
            amber: {
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>
  
  <!-- Custom Styles for Effects -->
  <style>
    html {
      scroll-behavior: smooth;
    }
    
    /* Glassmorphism */
    .glass {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .glass-dark {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
    }
    
    /* Text Gradient */
    .text-gradient {
      background: linear-gradient(135deg, #fde68a, #f59e0b, #d97706);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    
    /* Image Zoom on Hover */
    .img-zoom-container {
      overflow: hidden;
    }
    .img-zoom-container img {
      transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .group:hover .img-zoom-container img {
      transform: scale(1.1);
    }
    
    /* Buttons Glow */
    .btn-glow {
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
      transition: all 0.3s ease;
    }
    .btn-glow:hover {
      box-shadow: 0 0 30px rgba(245, 158, 11, 0.6);
      transform: translateY(-2px);
    }
    
    /* Offset Border (About Us) */
    .offset-border {
      position: relative;
    }
    .offset-border::after {
      content: '';
      position: absolute;
      top: 20px;
      left: 20px;
      right: -20px;
      bottom: -20px;
      border: 3px solid #f59e0b;
      border-radius: 1.5rem;
      z-index: -1;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-amber-500 selection:text-white">

  <!-- Navigation -->
  <nav class="fixed w-full z-50 glass-dark transition-all duration-300 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
        <img src="/images/logo.png" alt="Nayaka Tour" class="h-9 w-auto object-contain">
      </a>
      
      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="#destinations" class="text-slate-200 hover:text-white transition-colors font-medium">Destinasi</a>
        <a href="#why-us" class="text-slate-200 hover:text-white transition-colors font-medium">Mengapa Kami</a>
        <a href="#about" class="text-slate-200 hover:text-white transition-colors font-medium">Tentang</a>
        
        <div class="flex items-center space-x-4 pl-4 border-l border-white/20">
          <% if (user) { %>
            <% if (user.role === 'ADMIN') { %>
              <a href="/admin/dashboard" class="text-slate-200 hover:text-amber-400 transition-colors font-medium text-sm"><i class="fa-solid fa-gauge mr-1"></i> Dashboard</a>
            <% } %>
            <a href="/auth/logout" class="px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10 font-medium transition-all text-sm">Logout</a>
          <% } else { %>
            <a href="/auth/login" class="px-5 py-2.5 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-white font-medium shadow-[0_0_15px_rgba(245,158,11,0.5)] transition-all text-sm">Masuk / Daftar</a>
          <% } %>
        </div>
      </div>
      
      <!-- Mobile Menu Button -->
      <button class="md:hidden text-white focus:outline-none">
        <i class="fa-solid fa-bars text-2xl"></i>
      </button>
    </div>
  </nav>

  <!-- Hero Section Ultra Eye-Catching -->
  <section class="relative min-h-[100svh] flex items-center justify-center pt-20 overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1542662565-7e4b66ae458f?q=80&w=2560&auto=format&fit=crop" alt="Majalengka Mountain View" class="w-full h-full object-cover object-center filter brightness-[0.7]" />
      <div class="absolute inset-0 bg-gradient-to-b from-navy-950/70 via-navy-900/40 to-slate-50"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
      
      <!-- Glassmorphism Badge -->
      <div class="glass inline-flex items-center gap-2 px-4 py-2 rounded-full text-white/90 font-medium text-sm mb-8 animate-bounce-slow shadow-lg">
        <span class="text-xl">🚗</span> 
        <span>Liburan Anti Macet, Pikiran Tenang</span>
      </div>
      
      <!-- Headline Hook Utama -->
      <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight leading-tight mb-6 max-w-5xl drop-shadow-2xl">
        Muncak 4 Jam Kena Macet? <br class="hidden md:block" />
        Mending Ke <span class="text-gradient">Majalengka!</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-lg md:text-xl text-slate-200 mb-10 max-w-2xl font-light leading-relaxed drop-shadow-md">
        Tinggalkan hiruk pikuk kota. Temukan surga tersembunyi, udara sejuk pegunungan, dan pengalaman alam autentik yang menenangkan jiwa, tanpa perlu tua di jalan.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <a href="#destinations" class="btn-glow px-8 py-4 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 text-white font-bold text-lg flex items-center gap-2 w-full sm:w-auto justify-center">
          Jelajahi Sekarang <i class="fa-solid fa-arrow-right"></i>
        </a>
        <a href="#why-us" class="px-8 py-4 rounded-full glass text-white font-semibold text-lg hover:bg-white/20 transition-all flex items-center gap-2 w-full sm:w-auto justify-center">
          <i class="fa-regular fa-circle-play"></i> Tonton Video
        </a>
      </div>
      
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 z-10 flex flex-col items-center text-white/50 animate-pulse">
      <span class="text-sm tracking-widest uppercase font-semibold mb-2">Scroll</span>
      <i class="fa-solid fa-chevron-down"></i>
    </div>
  </section>

  <!-- Floating Stats Counter Section -->
  <section class="relative z-20 -mt-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <div class="glass-card rounded-3xl shadow-2xl p-8 md:p-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-slate-200/50">
        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-extrabold text-navy-900 mb-2">15+</div>
          <p class="text-slate-500 font-medium text-sm uppercase tracking-wider">Destinasi Rahasia</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-extrabold text-navy-900 mb-2">2.5K</div>
          <p class="text-slate-500 font-medium text-sm uppercase tracking-wider">Happy Travelers</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-extrabold text-amber-500 mb-2">4.9</div>
          <p class="text-slate-500 font-medium text-sm uppercase tracking-wider">Rating Review</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-extrabold text-navy-900 mb-2">100%</div>
          <p class="text-slate-500 font-medium text-sm uppercase tracking-wider">Bebas Macet</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Destinations (Interactive & Clean Components) -->
  <section id="destinations" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-amber-600 font-bold tracking-widest uppercase text-sm mb-2 block">Pilihan Terbaik</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-navy-900 mb-4">Destinasi Impianmu</h2>
        <div class="h-1.5 w-24 bg-gradient-to-r from-amber-400 to-amber-600 mx-auto rounded-full"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (typeof destinations !== 'undefined' && destinations.length > 0) { %>
          <% destinations.forEach(dest => { %>
            <div class="group bg-white rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.05)] hover:shadow-[0_10px_40px_rgba(0,0,0,0.1)] transition-all duration-500 border border-slate-100 flex flex-col h-full transform hover:-translate-y-2 relative">
              
              <!-- Badge Floating -->
              <div class="absolute top-4 left-4 z-10 glass px-3 py-1 rounded-full text-xs font-bold text-white shadow-lg backdrop-blur-md">
                <i class="fa-solid fa-fire text-amber-400 mr-1"></i> Populer
              </div>
              
              <!-- Image Container with Zoom -->
              <div class="img-zoom-container h-64 w-full relative bg-slate-200">
                <img src="<%= dest.thumbnail %>" alt="<%= dest.title %>" 
                     class="w-full h-full object-cover"
                     onerror="this.src='https://images.unsplash.com/photo-1542662565-7e4b66ae458f?auto=format&fit=crop&w=800&q=80'">
                <div class="absolute inset-0 bg-gradient-to-t from-navy-900/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
              
              <!-- Card Content -->
              <div class="p-6 flex-grow flex flex-col">
                <div class="flex justify-between items-start mb-3">
                  <h3 class="text-2xl font-bold text-navy-900 group-hover:text-amber-600 transition-colors line-clamp-1"><%= dest.title %></h3>
                </div>
                
                <p class="text-slate-600 mb-6 text-sm line-clamp-3 leading-relaxed flex-grow">
                  <%= dest.summary %>
                </p>
                
                <div class="pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
                  <span class="text-slate-500 text-sm font-medium flex items-center gap-1">
                    <i class="fa-solid fa-location-dot text-amber-500"></i> Majalengka
                  </span>
                  <a href="/destinations/<%= dest.slug %>" class="inline-flex items-center gap-2 text-navy-900 font-bold hover:text-amber-600 transition-colors">
                    Eksplor <i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full text-center py-12">
            <div class="inline-block p-6 rounded-full bg-slate-100 mb-4 text-slate-400">
              <i class="fa-solid fa-compass text-4xl"></i>
            </div>
            <h3 class="text-xl font-bold text-slate-700 mb-2">Belum ada destinasi</h3>
            <p class="text-slate-500">Admin kami sedang menyiapkan rute terbaik untuk Anda.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- About Us Section (Split Layout) -->
  <section id="about" class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        
        <!-- Left: Narrative -->
        <div class="w-full lg:w-1/2">
          <span class="text-amber-600 font-bold tracking-widest uppercase text-sm mb-4 block">Cerita Kami</span>
          <h2 class="text-4xl md:text-5xl font-extrabold text-navy-900 mb-6 leading-tight">
            Menemukan Kembali<br/>
            <span class="text-amber-500">Kedamaian Alam</span>
          </h2>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            Majalengka bukan sekadar alternatif, melainkan destinasi utama bagi Anda yang lelah dengan kemacetan puncak. Dengan lanskap terasering panyaweuyan yang ikonik, udara sejuk lereng Ciremai, dan kejernihan situ alami.
          </p>
          <p class="text-slate-600 mb-8 leading-relaxed">
            Nayaka Tour hadir sebagai teman perjalanan lokal yang siap memandu Anda mengeksplorasi sudut-sudut rahasia Majalengka yang belum banyak terjamah turis mainstream. Kenyamanan, keamanan, dan pengalaman autentik adalah janji kami.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <div class="flex items-center gap-3 bg-slate-50 px-5 py-3 rounded-xl border border-slate-100">
              <i class="fa-solid fa-circle-check text-amber-500 text-xl"></i>
              <span class="font-semibold text-navy-900">Guide Lokal Berpengalaman</span>
            </div>
            <div class="flex items-center gap-3 bg-slate-50 px-5 py-3 rounded-xl border border-slate-100">
              <i class="fa-solid fa-circle-check text-amber-500 text-xl"></i>
              <span class="font-semibold text-navy-900">Fasilitas Premium</span>
            </div>
          </div>
        </div>
        
        <!-- Right: Image Collage with Offset Border -->
        <div class="w-full lg:w-1/2 relative mt-12 lg:mt-0 px-6 lg:px-0">
          <div class="offset-border rounded-2xl overflow-hidden aspect-[4/3] shadow-2xl relative z-10 bg-slate-200">
            <img src="https://images.unsplash.com/photo-1596404984252-4467c6999b70?auto=format&fit=crop&w=1200&q=80" alt="Majalengka Terraces" class="w-full h-full object-cover">
          </div>
          <!-- Decor element -->
          <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-amber-500/10 rounded-full blur-3xl z-0"></div>
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-navy-900/10 rounded-full blur-3xl z-0"></div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section id="why-us" class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 max-w-2xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-extrabold text-navy-900 mb-6">Mengapa Nayaka Tour?</h2>
        <p class="text-lg text-slate-600">Komitmen kami adalah memberikan pengalaman liburan yang bebas stres, eksklusif, dan sepenuhnya tentang Anda.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Feature 1 -->
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-slate-100 group">
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-white transition-colors duration-300">
            <i class="fa-solid fa-car-side"></i>
          </div>
          <h4 class="text-xl font-bold text-navy-900 mb-3">Anti Macet Club</h4>
          <p class="text-slate-500 text-sm leading-relaxed">Rute eksklusif yang dirancang khusus untuk menghindari kemacetan, waktu Anda terlalu berharga untuk dihabiskan di jalan.</p>
        </div>
        
        <!-- Feature 2 -->
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-slate-100 group">
          <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center text-2xl mb-6 group-hover:bg-blue-500 group-hover:text-white transition-colors duration-300">
            <i class="fa-solid fa-leaf"></i>
          </div>
          <h4 class="text-xl font-bold text-navy-900 mb-3">Hidden Gems</h4>
          <p class="text-slate-500 text-sm leading-relaxed">Akses ke destinasi eksotik yang belum terjamah, memberikan Anda privasi dan keindahan alam yang hakiki.</p>
        </div>
        
        <!-- Feature 3 -->
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-slate-100 group">
          <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-500 flex items-center justify-center text-2xl mb-6 group-hover:bg-emerald-500 group-hover:text-white transition-colors duration-300">
            <i class="fa-solid fa-camera-retro"></i>
          </div>
          <h4 class="text-xl font-bold text-navy-900 mb-3">Spot Aesthetic</h4>
          <p class="text-slate-500 text-sm leading-relaxed">Garansi spot foto terbaik. Guide kami juga siap bantu ambil foto/video untuk feed sosmed Anda.</p>
        </div>
        
        <!-- Feature 4 -->
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-slate-100 group">
          <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center text-2xl mb-6 group-hover:bg-rose-500 group-hover:text-white transition-colors duration-300">
            <i class="fa-solid fa-heart"></i>
          </div>
          <h4 class="text-xl font-bold text-navy-900 mb-3">All-in Service</h4>
          <p class="text-slate-500 text-sm leading-relaxed">Makan, tiket masuk, transportasi, semua sudah diurus. Anda cukup bawa koper dan senyuman bahagia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-navy-900"></div>
    <!-- Decor element -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl transform translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl transform -translate-x-1/3 translate-y-1/3"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6">Siap Healing Tanpa Pusing?</h2>
      <p class="text-xl text-slate-300 mb-10 font-light max-w-2xl mx-auto">Jadwalkan perjalanan Anda bersama kami dan rasakan pengalaman tak terlupakan di Majalengka.</p>
      <a href="https://wa.me/6281212511829" class="btn-glow inline-flex items-center gap-3 px-8 py-4 rounded-full bg-amber-500 text-white font-bold text-lg hover:bg-amber-600 transition-colors">
        <i class="fa-brands fa-whatsapp text-2xl"></i> Konsultasi via WhatsApp
      </a>
    </div>
  </section>

  <!-- Footer Dark Theme -->
  <footer class="bg-navy-950 pt-20 pb-10 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
        
        <!-- Brand -->
        <div class="col-span-1 lg:col-span-1">
          <a href="/" class="block mb-6">
           <img src="/images/logo.png" alt="Nayaka Tour" class="h-9 w-auto object-contain">
          </a>
          </a>
          <p class="text-slate-400 text-sm leading-relaxed mb-6">
            Penyedia jasa travel premium yang berfokus pada eksplorasi keindahan Majalengka tanpa hambatan kemacetan.
          </p>
          <div class="flex space-x-4">
            <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-amber-500 hover:text-white transition-colors">
              <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-amber-500 hover:text-white transition-colors">
              <i class="fa-brands fa-tiktok"></i>
            </a>
            <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-amber-500 hover:text-white transition-colors">
              <i class="fa-brands fa-youtube"></i>
            </a>
          </div>
        </div>
        
        <!-- Quick Links -->
        <div>
          <h4 class="text-white font-bold mb-6 text-lg">Eksplor</h4>
          <ul class="space-y-4">
            <li><a href="#destinations" class="text-slate-400 hover:text-amber-500 transition-colors text-sm">Destinasi Pilihan</a></li>
            <li><a href="#about" class="text-slate-400 hover:text-amber-500 transition-colors text-sm">Tentang Nayaka</a></li>
            <li><a href="#why-us" class="text-slate-400 hover:text-amber-500 transition-colors text-sm">Mengapa Kami</a></li>
            <li><a href="#" class="text-slate-400 hover:text-amber-500 transition-colors text-sm">Testimoni</a></li>
          </ul>
        </div>
        
        <!-- Support -->
        <div>
          <h4 class="text-white font-bold mb-6 text-lg">Bantuan</h4>
          <ul class="space-y-4">
            <li><a href="#" class="text-slate-400 hover:text-amber-500 transition-colors text-sm">FAQ</a></li>
